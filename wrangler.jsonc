{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frgmt-xyz",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "frgmt.xyz/*", "zone_name": "frgmt.xyz" },
    { "pattern": "www.frgmt.xyz/*", "zone_name": "frgmt.xyz" }
  ]
}
